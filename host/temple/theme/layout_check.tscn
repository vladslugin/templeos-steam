; Named on the command line so that application/run/main_scene is not used:
; Godot instantiates the main scene even when another entry point is given, and
; the main scene here is the launcher, which connects to the guest on startup.
;
;   godot --headless --path host/temple res://theme/layout_check.tscn

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://theme/layout_check.gd" id="1"]

[node name="LayoutCheck" type="Node"]
script = ExtResource("1")
